<!DOCTYPE html>
<html lang="en-US">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="referrer" content="no-referrer" />
        <link rel="stylesheet" href="/css/style.css">
        <link rel="icon" href="/icon.svg">
        <title>Invidious Instances</title>

        <style>
        #table-heading-health:after {
            content: "Uptime / Downtime displayed in percentage"
        }
        </style>
    </head>

    <body>
        <header>
            <p>
                <span>To add your instance below please open an issue on <a href="https://github.com/iv-org/documentation/">the documentation repository</a>.</span>
                <span class="right"><a href="/instances.json?pretty=1<% if sort_by != "users" %>&sort_by=<%= sort_by %><% end %>">JSON</a></span>
            </p>
        </header>
        <table>
            <thead>
                <tr>
                    <th><a href="/?sort_by=<%= sort_by == "name" ? "name-reverse" : "name" %>">name</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "version" ? "version-reverse" : "version" %>">version</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "type" ? "type-reverse" : "type" %>">type</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "users" ? "users-reverse" : "users" %>">users</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "signup" ? "signup-reverse" : "signup" %>">signup</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "location" ? "location-reverse" : "location" %>">location</a></th>
                    <th id="table-heading-health"><a href="/?sort_by=<%= sort_by == "health" ? "health-reverse" : "health" %>" title="Uptime / Downtime displayed in percentage">health</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "cors" ? "cors-reverse" : "cors" %>">cors</a></th>
                    <th><a href="/?sort_by=<%= sort_by == "api" ? "api-reverse" : "api" %>">api</a></th>
                </tr>
            </thead>
            <tbody>
                <% @instances.get do | instances_list | %>
                    <% instances_list.each do | package | %>
                        <% name, instance = package %>
                        <%
                            # TODO: Serialize to html through Instance struct
                        %>
                        <tr>
                            <td><a href="<%= instance.url %>"><%= name.size > 24 ? "#{name[0, 12]}...#{name[-9, 9]}" : name %></a></td>
                            <td><%= instance.stats.try &.["software"]?.try &.["version"] || "-" %></td>
                            <td><%= instance.instance_type == IAI::InstanceType::Clearnet ? "https" : instance.instance_type.to_s.downcase %></td>
                            <td><%= instance.stats.try &.["usage"]?.try &.["users"]["total"] || "-" %></td>
                            <td><%= instance.stats.try &.["openRegistrations"]?.try { |bool| bool.as_bool ? "✔" : "❌" } || "-" %></td>
                            <td><%= instance.flag ? "#{instance.flag} #{instance.region}" : "-" %></td>
                            <td><a href='https://updown.io/<%= instance.monitor.try &.["token"] || "p/resvf" %>'><%= instance.monitor.try &.["uptime"] || "-" %></a></td>
                            <td><%= instance.cors == nil ? "-" : instance.cors ? "✔" : "❌" %></td>
                            <td><%= instance.api == nil ? "-" : instance.api ? "✔" : "❌" %></td>
                        </tr>
                    <% end %>
                <% end %>
            </tbody>
        </table>
        <footer>
            <p>
                Health is Uptime / Downtime displayed in percentage.
                <br>
                Released under the AGPLv3. Source available <a href="https://github.com/iv-org/instances-api">here</a>.
            </p>
        </footer>
    </body>
</html>